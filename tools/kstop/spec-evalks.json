{
 "name": "evalks",
 "venv": "/opt/llm/runtime/vllm-venv-rssm",
 "model": "/opt/llm/models/qwen38-flash-next-mtpfp4",
 "env": {
  "FN_MAXLEN": "32768",
  "FN_SEQS": "23",
  "FN_SPEC_METHOD": "mtp",
  "FN_SPEC_N": "5",
  "FN_SPEC_NODROP": "1",
  "FN_SPEC_LOCALARGMAX": "0",
  "FN_DRAFT_VOCAB": "/opt/llm/runners/dv/draft_vocab_32768.txt",
  "FN_PLE_OFFLOAD": "0",
  "FN_EXTRA": "--engram-config {\"checkpoint_mapped\":true} --use-replayssm --block-size 1728 --prefix-match-unit 64 --mamba-ssm-cache-dtype bfloat16 --kv-cache-memory-bytes 4294967296",
  "FN_DRAFT_HEAD_NVFP4": "1",
  "FN_NVFP4_CFG": "64,4",
  "FN_DRAFT_PROB": "1",
  "FN_SPEC_DRAFTPROB": "1",
  "FN_CG_SIZES": "[1,2,4,6,8,12,16,18,24,30,36,48,60,72,96]",
  "ARMRUN_LAUNCHER": "/opt/llm/runners/kstop/serve-dynsd.sh"
 },
 "probe_cmd": [
  "<venv>/bin/python",
  "/opt/llm/runners/evalq/evalprobe.py",
  "{arm}"
 ],
 "starts": 2,
 "arms": [
  {
   "name": "kstop",
   "env": {
    "FN_CG_MODE": "FULL_AND_PIECEWISE",
    "FN_HCFUSE": "1",
    "FN_SPEC_N": "7",
    "FN_KSTOP": "1",
    "FN_KSTOP_TAU": "0.75",
    "FN_KSTOP_SIZE": "runner",
    "FN_SPEC_DYN": "1:16:7,17:17:6,18:18:5,19:19:4,20:20:3,21:21:2,22:23:1"
   },
   "env_unset": [
    "FN_GDN_RECOVERSSM",
    "FNQKVVIEW",
    "FN_BF16SK",
    "FN_AV_PW",
    "FN_SPEC_AV",
    "FN_DRAFT_PW",
    "FN_MTP_DENSE_NVFP4",
    "FN_GDNNQ"
   ],
   "log_must_contain": [
    "NVFP4 slice, FNNVFP4",
    "Mapped PLE table",
    "GDN RecoverSSM speculative verify active",
    "GDN RecoverSSM path taken",
    "PLE RecoverSSM path taken",
    "enable_prefix_caching=True",
    "num_spec_tokens=7)",
    "FNDRAFTPROB path taken",
    "cudagraph_capture_sizes': [1, 2, 4, 6, 8, 12, 16, 18, 24, 30, 36, 48, 60, 72, 96]",
    "Mamba cache mode is set to 'align'",
    "'prefix_match_unit': 64",
    "mamba_ssm_cache_dtype': 'bfloat16'",
    "MTP name prefilter",
    "Capturing CUDA graphs (PIECEWISE)",
    "FNHCFUSE fused hyper-connection kernels ran",
    "Capturing CUDA graphs (FULL)",
    "FNKSTOP active: tau 0.75, verify sized to the draft count: True (runner)",
    "FNKSTOP IF-node draft decode graphs",
    "num_speculative_tokens_per_batch_size': [[1, 16, 7]"
   ],
   "log_must_not_contain": [
    "Using local argmax reduction",
    "FNAVPW",
    "FNDRAFTPW",
    "FNMTPDENSE",
    "FNBF16SK",
    "FNGDNNQ"
   ]
  }
 ]
}