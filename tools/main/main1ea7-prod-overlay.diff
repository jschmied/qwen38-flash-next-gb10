+        _FN_DROPPED[0] += 1
+        _FN_DROPPED[1] += os.path.getsize(st_file)
+        if _FN_DROPPED[0] in (1, 50, 100, 150, 196):
+            logger.warning("FNDROPCACHE dropped %d shards, %.1f GiB", _FN_DROPPED[0], _FN_DROPPED[1] / 2**30)
+    except OSError as e:
+        logger.warning("FNDROPCACHE failed on %s: %s", st_file, e)
