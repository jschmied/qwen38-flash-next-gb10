--- a/vllm/models/qwen4_exp/nvidia/fn_nvfp4_head.py	1970-01-01 01:00:00.000000000 +0100
+++ b/vllm/models/qwen4_exp/nvidia/fn_nvfp4_head.py	2026-09-24 17:23:09.000000000 +0200
