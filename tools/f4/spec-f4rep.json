{
 "name": "f4rep",
 "venv": "/opt/llm/runtime/vllm-venv-rssm",
 "model": "/opt/llm/models/qwen38-flash-next-mtpfp4",
 "env": {
  "FN_MAXLEN": "32768",
  "FN_SEQS": "16",
  "FN_SPEC_METHOD": "mtp",
  "FN_SPEC_N": "5",
  "FN_SPEC_NODROP": "1",
  "FN_SPEC_LOCALARGMAX": "0",
  "FN_DRAFT_VOCAB": "/opt/llm/runners/dv/draft_vocab_32768.txt",
  "FN_PLE_OFFLOAD": "0",
  "FN_EXTRA": "--engram-config {\"checkpoint_mapped\":true} --use-replayssm --block-size 1728 --prefix-match-unit 64 --mamba-ssm-cache-dtype bfloat16 --kv-cache-memory-bytes 4294967296",
  "FN_DRAFT_HEAD_NVFP4": "1",
  "FN_NVFP4_CFG": "64,4",
  "FN_DRAFT_PROB": "1",
  "FN_SPEC_DRAFTPROB": "1",
  "FN_CG_SIZES": "[1,2,4,6,8,12,16,18,24,30,36,48,60,72,96]",
  "ARMRUN_LAUNCHER": "/opt/llm/serve-flashnext.sh"
 },
 "probe_cmd": [
  "<venv>/bin/python",
  "/opt/llm/runners/f4/replayprobe.py",
  "{arm}"
 ],
 "starts": 2,
 "arms": [
  {
   "name": "full",
   "env": {
    "FN_CG_MODE": "FULL_AND_PIECEWISE"
   },
   "env_unset": [
    "FN_GDN_RECOVERSSM",
    "FNQKVVIEW",
    "FN_BF16SK",
    "FN_AV_PW",
    "FN_SPEC_AV",
    "FN_DRAFT_PW",
    "FN_MTP_DENSE_NVFP4"
   ],
   "log_must_contain": [
    "NVFP4 slice, FNNVFP4",
    "Mapped PLE table",
    "GDN RecoverSSM speculative verify active",
    "GDN RecoverSSM path taken",
    "PLE RecoverSSM path taken",
    "enable_prefix_caching=True",
    "num_spec_tokens=5)",
    "FNDRAFTPROB path taken",
    "cudagraph_capture_sizes': [1, 2, 4, 6, 8, 12, 16, 18, 24, 30, 36, 48, 60, 72, 96]",
    "Mamba cache mode is set to 'align'",
    "'prefix_match_unit': 64",
    "mamba_ssm_cache_dtype': 'bfloat16'",
    "MTP name prefilter",
    "Capturing CUDA graphs (FULL)",
    "CUDAGraphMode.FULL_AND_PIECEWISE"
   ],
   "log_must_not_contain": [
    "Using local argmax reduction",
    "FNAVPW",
    "FNDRAFTPW",
    "FNMTPDENSE",
    "FNBF16SK"
   ]
  },
  {
   "name": "pw",
   "env": {
    "FN_CG_MODE": "PIECEWISE"
   },
   "env_unset": [
    "FN_GDN_RECOVERSSM",
    "FNQKVVIEW",
    "FN_BF16SK",
    "FN_AV_PW",
    "FN_SPEC_AV",
    "FN_DRAFT_PW",
    "FN_MTP_DENSE_NVFP4"
   ],
   "log_must_contain": [
    "NVFP4 slice, FNNVFP4",
    "Mapped PLE table",
    "GDN RecoverSSM speculative verify active",
    "GDN RecoverSSM path taken",
    "PLE RecoverSSM path taken",
    "enable_prefix_caching=True",
    "num_spec_tokens=5)",
    "FNDRAFTPROB path taken",
    "cudagraph_capture_sizes': [1, 2, 4, 6, 8, 12, 16, 18, 24, 30, 36, 48, 60, 72, 96]",
    "Mamba cache mode is set to 'align'",
    "'prefix_match_unit': 64",
    "mamba_ssm_cache_dtype': 'bfloat16'",
    "MTP name prefilter",
    "Capturing CUDA graphs (PIECEWISE)"
   ],
   "log_must_not_contain": [
    "Using local argmax reduction",
    "FNAVPW",
    "FNDRAFTPW",
    "FNMTPDENSE",
    "FNBF16SK",
    "Capturing CUDA graphs (FULL)"
   ]
  }
 ]
}