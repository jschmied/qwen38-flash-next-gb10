{
 "name": "mtpd8a",
 "venv": "/opt/llm/runtime/vllm-venv-rssm",
 "model": "/opt/llm/models/qwen38-flash-next-mtpfp4",
 "env": {
  "FN_MAXLEN": "32768",
  "FN_SEQS": "16",
  "FN_SPEC_METHOD": "mtp",
  "FN_SPEC_N": "3",
  "FN_SPEC_NODROP": "1",
  "FN_SPEC_LOCALARGMAX": "1",
  "FN_DRAFT_VOCAB": "/opt/llm/runners/dv/draft_vocab_32768.txt",
  "FN_DRAFT_HEAD_NVFP4": "1",
  "FN_NVFP4_CFG": "64,4",
  "FN_PLE_OFFLOAD": "0",
  "FN_EXTRA": "--engram-config {\"checkpoint_mapped\":true} --kv-cache-memory-bytes 4294967296",
  "FN_VENV": "/opt/llm/runtime/vllm-venv-rssm",
  "VLLM_DISABLE_COMPILE_CACHE": "1"
 },
 "probe_cmd": [
  "<venv>/bin/python",
  "/opt/llm/runners/rssm/comboprobe2.py",
  "{arm}"
 ],
 "starts": 2,
 "arms": [
  {
   "name": "fp8",
   "env": {
    "FN_GDN_RECOVERSSM": "1",
    "FN_MTP_DENSE_NVFP4": "1",
    "FN_MTP_DENSE_FP8": "1"
   },
   "env_unset": [
    "FN_GDN_STORE_CS",
    "FN_BF16SK",
    "FN_PLE_SYNCTOUCH",
    "FN_PFTIME",
    "FNQKVVIEW"
   ],
   "log_must_contain": [
    "NVFP4 slice, FNNVFP4",
    "Mapped PLE table",
    "'kv_cache_memory_bytes': 4294967296",
    "FNRSSM: GDN RecoverSSM speculative verify active",
    "GDN RecoverSSM path taken",
    "Mamba cache mode is set to 'align'",
    "enable_prefix_caching=True",
    "GDN RecoverSSM path taken: ",
    "align=True",
    "FNRSSM PLE RecoverSSM path taken",
    "FNMTPDENSE8 armed: 4 MTP dense linears",
    "FNMTPDENSE8 path taken"
   ],
   "log_must_not_contain": [
    "FNBF16SK",
    "FNPOPULATE",
    "FNDROPCACHE",
    "FNSYNCTOUCH",
    "FNGDNCS",
    "FNQKVVIEW path taken"
   ]
  },
  {
   "name": "base",
   "env": {
    "FN_GDN_RECOVERSSM": "1"
   },
   "env_unset": [
    "FNQKVVIEW",
    "FN_BF16SK",
    "FN_GDN_STORE_CS",
    "FN_MTP_DENSE_FP8",
    "FN_MTP_DENSE_LAYERS",
    "FN_MTP_DENSE_NVFP4",
    "FN_PFTIME",
    "FN_PLE_SYNCTOUCH"
   ],
   "log_must_contain": [
    "NVFP4 slice, FNNVFP4",
    "Mapped PLE table",
    "'kv_cache_memory_bytes': 4294967296",
    "FNRSSM: GDN RecoverSSM speculative verify active",
    "GDN RecoverSSM path taken",
    "Mamba cache mode is set to 'align'",
    "enable_prefix_caching=True",
    "GDN RecoverSSM path taken: ",
    "align=True",
    "FNRSSM PLE RecoverSSM path taken"
   ],
   "log_must_not_contain": [
    "FNBF16SK",
    "FNPOPULATE",
    "FNDROPCACHE",
    "FNSYNCTOUCH",
    "FNGDNCS",
    "FNQKVVIEW path taken",
    "FNMTPDENSE"
   ]
  }
 ]
}