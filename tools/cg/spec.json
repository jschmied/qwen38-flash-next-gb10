{
 "name": "cgwidth",
 "venv": "/opt/llm/runtime/vllm-venv-rssm",
 "model": "/opt/llm/models/qwen38-flash-next-mtpfp4",
 "env": {
  "FN_MAXLEN": "32768",
  "FN_SEQS": "16",
  "FN_SPEC_METHOD": "mtp",
  "FN_SPEC_N": "3",
  "FN_SPEC_NODROP": "1",
  "FN_SPEC_LOCALARGMAX": "1",
  "FN_DRAFT_VOCAB": "/opt/llm/runners/dv/draft_vocab_32768.txt",
  "FN_DRAFT_HEAD_NVFP4": "1",
  "FN_NVFP4_CFG": "64,4",
  "FN_PLE_OFFLOAD": "0",
  "FN_EXTRA": "--engram-config {\"checkpoint_mapped\":true} --kv-cache-memory-bytes 4294967296",
  "FN_VENV": "/opt/llm/runtime/vllm-venv-rssm"
 },
 "probe_cmd": [
  "<venv>/bin/python",
  "/opt/llm/runners/cg/comboprobe3.py",
  "{arm}"
 ],
 "starts": 2,
 "arms": [
  {
   "name": "cg8",
   "env": {
    "FN_GDN_RECOVERSSM": "1"
   },
   "env_unset": [
    "FN_BF16SK",
    "FN_DYN_DRAFT",
    "FN_DYN_DRAFT_THR",
    "FN_GDN_RECOVERSSM_DEFER",
    "FN_GDN_STORE_CS",
    "FN_PFTIME",
    "FN_PLE_SYNCTOUCH",
    "FN_CG_SIZES"
   ],
   "log_must_contain": [
    "NVFP4 slice, FNNVFP4",
    "Mapped PLE table",
    "'kv_cache_memory_bytes': 4294967296",
    "FNRSSM: GDN RecoverSSM speculative verify active",
    "GDN RecoverSSM path taken",
    "Mamba cache mode is set to 'align'",
    "enable_prefix_caching=True",
    "GDN RecoverSSM path taken: ",
    "align=True",
    "FNRSSM PLE RecoverSSM path taken",
    "'max_cudagraph_capture_size': 8,"
   ],
   "log_must_not_contain": [
    "FNBF16SK",
    "FNPOPULATE",
    "FNDROPCACHE",
    "FNSYNCTOUCH",
    "FNGDNCS"
   ]
  },
  {
   "name": "cg64",
   "env": {
    "FN_GDN_RECOVERSSM": "1",
    "FN_CG_SIZES": "[1,2,4,8,12,16,24,32,48,64]"
   },
   "env_unset": [
    "FN_BF16SK",
    "FN_DYN_DRAFT",
    "FN_DYN_DRAFT_THR",
    "FN_GDN_RECOVERSSM_DEFER",
    "FN_GDN_STORE_CS",
    "FN_PFTIME",
    "FN_PLE_SYNCTOUCH"
   ],
   "log_must_contain": [
    "NVFP4 slice, FNNVFP4",
    "Mapped PLE table",
    "'kv_cache_memory_bytes': 4294967296",
    "FNRSSM: GDN RecoverSSM speculative verify active",
    "GDN RecoverSSM path taken",
    "Mamba cache mode is set to 'align'",
    "enable_prefix_caching=True",
    "GDN RecoverSSM path taken: ",
    "align=True",
    "FNRSSM PLE RecoverSSM path taken",
    "'max_cudagraph_capture_size': 64,"
   ],
   "log_must_not_contain": [
    "FNBF16SK",
    "FNPOPULATE",
    "FNDROPCACHE",
    "FNSYNCTOUCH",
    "FNGDNCS"
   ]
  }
 ]
}