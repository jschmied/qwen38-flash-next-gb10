{
 "name": "ksweep",
 "venv": "/opt/llm/runtime/vllm-venv-rssm",
 "model": "/opt/llm/models/qwen38-flash-next-mtpfp4",
 "env": {
  "FN_MAXLEN": "32768",
  "FN_SEQS": "16",
  "FN_SPEC_METHOD": "mtp",
  "FN_SPEC_N": "3",
  "FN_SPEC_NODROP": "1",
  "FN_SPEC_LOCALARGMAX": "1",
  "FN_DRAFT_VOCAB": "/opt/llm/runners/dv/draft_vocab_32768.txt",
  "FN_DRAFT_HEAD_NVFP4": "1",
  "FN_NVFP4_CFG": "64,4",
  "FN_PLE_OFFLOAD": "0",
  "FN_EXTRA": "--engram-config {\"checkpoint_mapped\":true} --kv-cache-memory-bytes 4294967296",
  "FN_VENV": "/opt/llm/runtime/vllm-venv-rssm",
  "FN_CG_SIZES": "[1,2,4,5,6,8,10,12,16,20,24]"
 },
 "probe_cmd": [
  "<venv>/bin/python",
  "/opt/llm/runners/ksweep/codeprobe.py",
  "{arm}"
 ],
 "starts": 2,
 "arms": [
  {
   "name": "k3",
   "env": {
    "FN_GDN_RECOVERSSM": "1",
    "FN_SPEC_N": "3"
   },
   "env_unset": [
    "FN_GDN_STORE_CS",
    "FN_BF16SK",
    "FN_PLE_SYNCTOUCH",
    "FN_PFTIME",
    "FNQKVVIEW"
   ],
   "log_must_contain": [
    "NVFP4 slice, FNNVFP4",
    "Mapped PLE table",
    "'kv_cache_memory_bytes': 4294967296",
    "FNRSSM: GDN RecoverSSM speculative verify active",
    "GDN RecoverSSM path taken",
    "Mamba cache mode is set to 'align'",
    "enable_prefix_caching=True",
    "GDN RecoverSSM path taken: ",
    "align=True",
    "FNRSSM PLE RecoverSSM path taken",
    "num_spec_tokens=3)",
    "cudagraph_capture_sizes': [1, 2, 4, 5, 6, 8, 10, 12, 16, 20, 24]"
   ],
   "log_must_not_contain": [
    "FNBF16SK",
    "FNPOPULATE",
    "FNDROPCACHE",
    "FNSYNCTOUCH",
    "FNGDNCS",
    "FNQKVVIEW path taken"
   ]
  },
  {
   "name": "k4",
   "env": {
    "FN_GDN_RECOVERSSM": "1",
    "FN_SPEC_N": "4"
   },
   "env_unset": [
    "FN_GDN_STORE_CS",
    "FN_BF16SK",
    "FN_PLE_SYNCTOUCH",
    "FN_PFTIME",
    "FNQKVVIEW"
   ],
   "log_must_contain": [
    "NVFP4 slice, FNNVFP4",
    "Mapped PLE table",
    "'kv_cache_memory_bytes': 4294967296",
    "FNRSSM: GDN RecoverSSM speculative verify active",
    "GDN RecoverSSM path taken",
    "Mamba cache mode is set to 'align'",
    "enable_prefix_caching=True",
    "GDN RecoverSSM path taken: ",
    "align=True",
    "FNRSSM PLE RecoverSSM path taken",
    "num_spec_tokens=4)",
    "cudagraph_capture_sizes': [1, 2, 4, 5, 6, 8, 10, 12, 16, 20, 24]"
   ],
   "log_must_not_contain": [
    "FNBF16SK",
    "FNPOPULATE",
    "FNDROPCACHE",
    "FNSYNCTOUCH",
    "FNGDNCS",
    "FNQKVVIEW path taken"
   ]
  },
  {
   "name": "k5",
   "env": {
    "FN_GDN_RECOVERSSM": "1",
    "FN_SPEC_N": "5",
    "FN_EXTRA": "--engram-config {\"checkpoint_mapped\":true} --kv-cache-memory-bytes 4294967296 --block-size 1728"
   },
   "env_unset": [
    "FN_GDN_STORE_CS",
    "FN_BF16SK",
    "FN_PLE_SYNCTOUCH",
    "FN_PFTIME",
    "FNQKVVIEW"
   ],
   "log_must_contain": [
    "NVFP4 slice, FNNVFP4",
    "Mapped PLE table",
    "'kv_cache_memory_bytes': 4294967296",
    "FNRSSM: GDN RecoverSSM speculative verify active",
    "GDN RecoverSSM path taken",
    "Mamba cache mode is set to 'align'",
    "enable_prefix_caching=True",
    "GDN RecoverSSM path taken: ",
    "align=True",
    "FNRSSM PLE RecoverSSM path taken",
    "num_spec_tokens=5)",
    "cudagraph_capture_sizes': [1, 2, 4, 5, 6, 8, 10, 12, 16, 20, 24]"
   ],
   "log_must_not_contain": [
    "FNBF16SK",
    "FNPOPULATE",
    "FNDROPCACHE",
    "FNSYNCTOUCH",
    "FNGDNCS",
    "FNQKVVIEW path taken"
   ]
  }
 ]
}