{
 "name": "fncap2",
 "venv": "/opt/llm/runtime/vllm-venv-main1ea7",
 "model": "/opt/llm/models/qwen38-flash-next-mtpfp4",
 "env": {
  "FN_MAXLEN": "32768",
  "FN_SEQS": "16",
  "FN_SPEC_METHOD": "mtp",
  "FN_SPEC_N": "3",
  "FN_SPEC_NODROP": "1",
  "FN_SPEC_LOCALARGMAX": "1",
  "FN_DRAFT_VOCAB": "/opt/llm/runners/dv/draft_vocab_32768.txt",
  "FN_DRAFT_HEAD_NVFP4": "1",
  "FN_NVFP4_CFG": "64,4",
  "FN_PLE_OFFLOAD": "0",
  "FN_EXTRA": "--engram-config {\"checkpoint_mapped\":true} --enforce-eager",
  "FN_CAPTURE_DIR": "/opt/llm/capture/fncap2-0924",
  "FN_CAPTURE_RE": "(layers\\.(3|4)\\.(mlp\\.experts|(attn|mlp)_hyper_connection|linear_attn\\.in_proj_ba)$)|(^|\\.)lm_head$|^model\\.layers\\.0\\.mlp\\.experts$",
  "FN_CAPTURE_N": "12"
 },
 "probe_cmd": [
  "<venv>/bin/python",
  "/opt/llm/runners/fncap/capprobe.py",
  "{arm}",
  "/opt/llm/capture/fncap2-0924"
 ],
 "starts": 1,
 "arms": [
  {
   "name": "cap",
   "log_must_contain": [
    "FNCAP installed",
    "NVFP4 slice, FNNVFP4",
    "Mapped PLE table"
   ]
  }
 ]
}