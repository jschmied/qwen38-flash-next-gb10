{
  "name": "topk55122",
  "venv": "/opt/llm/runtime/vllm-venv-main1ea7",
  "model": "/opt/llm/models/qwen38-flash-next-mtpfp4",
  "env": {"FN_MAXLEN": "32768", "FN_SEQS": "16", "FN_SPEC_METHOD": "mtp", "FN_SPEC_N": "3",
          "FN_SPEC_NODROP": "1", "FN_SPEC_LOCALARGMAX": "1",
          "FN_DRAFT_VOCAB": "/opt/llm/runners/dv/draft_vocab_32768.txt",
          "FN_PLE_OFFLOAD": "0", "FN_EXTRA": "--engram-config {\"checkpoint_mapped\":true}"},
  "probe_cmd": ["<venv>/bin/python", "/opt/llm/runners/topk55122/topkprobe.py", "{arm}"],
  "starts": 2,
  "arms": [
    {"name": "stock", "env": {"FN_DET_TOPK": "0"},
     "log_must_contain": ["QSATOPK env path=stock", "Mapped PLE table"],
     "log_must_not_contain": ["QSATOPK env path=det", "QSATOPK env path=exact"]},
    {"name": "pr", "env": {"FN_DET_TOPK": "1", "FN_DET_LIB": "/opt/llm/runners/topk55122/build-pr-server/_C_det.so"},
     "log_must_contain": ["QSATOPK env path=det:/opt/llm/runners/topk55122/build-pr-server/_C_det.so", "Mapped PLE table"],
     "log_must_not_contain": ["QSATOPK env path=stock", "QSATOPK env path=exact"]},
    {"name": "exact", "env": {"FN_DET_TOPK": "0", "VLLM_QSA_EXACT_TOPK": "1"},
     "log_must_contain": ["QSATOPK env path=exact", "Mapped PLE table"],
     "log_must_not_contain": ["QSATOPK env path=stock", "QSATOPK env path=det"]}
  ]
}
