{
 "name": "avpw",
 "venv": "/opt/llm/runtime/vllm-venv-rssm",
 "model": "/opt/llm/models/qwen38-flash-next-mtpfp4",
 "env": {
  "FN_MAXLEN": "32768",
  "FN_SEQS": "1",
  "FN_SPEC_METHOD": "mtp",
  "FN_SPEC_N": "3",
  "FN_SPEC_NODROP": "1",
  "FN_SPEC_LOCALARGMAX": "1",
  "FN_DRAFT_VOCAB": "/opt/llm/runners/dv/draft_vocab_32768.txt",
  "FN_DRAFT_HEAD_NVFP4": "1",
  "FN_NVFP4_CFG": "64,4",
  "FN_PLE_OFFLOAD": "0",
  "FN_EXTRA": "--engram-config {\"checkpoint_mapped\":true} --kv-cache-memory-bytes 4294967296",
  "FN_VENV": "/opt/llm/runtime/vllm-venv-rssm",
  "FN_CG_SIZES": "[1,2,3,4,5,6]"
 },
 "probe_cmd": [
  "<venv>/bin/python",
  "/opt/llm/runners/avpw/codeprobe_c1.py",
  "{arm}"
 ],
 "starts": 3,
 "arms": [
  {
   "name": "k5av",
   "env": {
    "FN_SPEC_N": "5",
    "FN_EXTRA": "--engram-config {\"checkpoint_mapped\":true} --kv-cache-memory-bytes 4294967296 --block-size 1728 --use-replayssm",
    "ARMRUN_LAUNCHER": "/opt/llm/runners/avpw/serve-avpw.sh",
    "FN_DRAFT_PROB": "1",
    "FN_SPEC_AV": "1",
    "FN_AV_PW": "1",
    "VLLM_ADAPTIVE_VERIFICATION_PROFILE_CONTEXT_LEN": "2048"
   },
   "env_unset": [
    "FNQKVVIEW",
    "FN_BF16SK",
    "FN_DRAFT_PW",
    "FN_GDN_RECOVERSSM",
    "FN_GDN_STORE_CS",
    "FN_PFTIME",
    "FN_PLE_SYNCTOUCH",
    "FN_SPEC_DRAFTPROB",
    "FN_SPEC_LOCALARGMAX"
   ],
   "log_must_contain": [
    "NVFP4 slice, FNNVFP4",
    "Mapped PLE table",
    "'kv_cache_memory_bytes': 4294967296",
    "GDN RecoverSSM speculative verify active",
    "GDN RecoverSSM path taken",
    "Mamba cache mode is set to 'align'",
    "enable_prefix_caching=True",
    "GDN RecoverSSM path taken: ",
    "align=True",
    "num_spec_tokens=5)",
    "PLE RecoverSSM path taken",
    "FNDRAFTPROB path taken",
    "cudagraph_capture_sizes': [1, 2, 3, 4, 5, 6]",
    "FNAVPW adaptive verification"
   ],
   "log_must_not_contain": [
    "FNBF16SK",
    "FNPOPULATE",
    "FNDROPCACHE",
    "FNSYNCTOUCH",
    "FNGDNCS",
    "FNQKVVIEW path taken",
    "Using local argmax reduction"
   ]
  },
  {
   "name": "k5",
   "env": {
    "FN_SPEC_N": "5",
    "FN_EXTRA": "--engram-config {\"checkpoint_mapped\":true} --kv-cache-memory-bytes 4294967296 --block-size 1728 --use-replayssm",
    "ARMRUN_LAUNCHER": "/opt/llm/runners/avpw/serve-avpw.sh"
   },
   "env_unset": [
    "FNQKVVIEW",
    "FN_AV_PW",
    "FN_BF16SK",
    "FN_DRAFT_PROB",
    "FN_DRAFT_PW",
    "FN_GDN_RECOVERSSM",
    "FN_GDN_STORE_CS",
    "FN_PFTIME",
    "FN_PLE_SYNCTOUCH",
    "FN_SPEC_AV",
    "FN_SPEC_DRAFTPROB"
   ],
   "log_must_contain": [
    "NVFP4 slice, FNNVFP4",
    "Mapped PLE table",
    "'kv_cache_memory_bytes': 4294967296",
    "GDN RecoverSSM speculative verify active",
    "GDN RecoverSSM path taken",
    "Mamba cache mode is set to 'align'",
    "enable_prefix_caching=True",
    "GDN RecoverSSM path taken: ",
    "align=True",
    "num_spec_tokens=5)",
    "PLE RecoverSSM path taken",
    "Using local argmax reduction",
    "cudagraph_capture_sizes': [1, 2, 3, 4, 5, 6]"
   ],
   "log_must_not_contain": [
    "FNBF16SK",
    "FNPOPULATE",
    "FNDROPCACHE",
    "FNSYNCTOUCH",
    "FNGDNCS",
    "FNQKVVIEW path taken",
    "FNDRAFTPROB",
    "FNAVPW"
   ]
  },
  {
   "name": "k3",
   "env": {
    "FN_SPEC_N": "3",
    "FN_EXTRA": "--engram-config {\"checkpoint_mapped\":true} --kv-cache-memory-bytes 4294967296 --use-replayssm",
    "ARMRUN_LAUNCHER": "/opt/llm/runners/avpw/serve-avpw.sh"
   },
   "env_unset": [
    "FNQKVVIEW",
    "FN_AV_PW",
    "FN_BF16SK",
    "FN_DRAFT_PROB",
    "FN_DRAFT_PW",
    "FN_GDN_RECOVERSSM",
    "FN_GDN_STORE_CS",
    "FN_PFTIME",
    "FN_PLE_SYNCTOUCH",
    "FN_SPEC_AV",
    "FN_SPEC_DRAFTPROB"
   ],
   "log_must_contain": [
    "NVFP4 slice, FNNVFP4",
    "Mapped PLE table",
    "'kv_cache_memory_bytes': 4294967296",
    "GDN RecoverSSM speculative verify active",
    "GDN RecoverSSM path taken",
    "Mamba cache mode is set to 'align'",
    "enable_prefix_caching=True",
    "GDN RecoverSSM path taken: ",
    "align=True",
    "num_spec_tokens=3)",
    "PLE RecoverSSM path taken",
    "Using local argmax reduction",
    "cudagraph_capture_sizes': [1, 2, 3, 4, 5, 6]"
   ],
   "log_must_not_contain": [
    "FNBF16SK",
    "FNPOPULATE",
    "FNDROPCACHE",
    "FNSYNCTOUCH",
    "FNGDNCS",
    "FNQKVVIEW path taken",
    "FNDRAFTPROB",
    "FNAVPW"
   ]
  }
 ]
}