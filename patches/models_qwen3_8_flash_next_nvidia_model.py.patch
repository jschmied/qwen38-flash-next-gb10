+        # PATCH (jschmied 2026-08-28): pass quant_config so a quantized lm_head
+        # is actually honoured. Without it VocabParallelEmbedding.__init__ sees
+        # quant_config=None and installs UnquantizedEmbeddingMethod
+        # unconditionally, so a checkpoint declaring lm_head in
+        # `quantized_layers` loads only `lm_head.weight` and then dies on the
+        # missing scale tensor. The quant config resolves the layer correctly --
+        # it is simply never consulted. This is why no GPU checkpoint of this
+        # model quantizes lm_head: the model code cannot use one.
+        import sys as _sys
+        print(f"PROBE lmhead quant_config={self.quant_config!r} "
+              f"type={type(self.quant_config).__name__} "
+              f"prefix={maybe_prefix(prefix, 'lm_head')!r}", file=_sys.stderr, flush=True)
         self.lm_head = ParallelLMHead(
