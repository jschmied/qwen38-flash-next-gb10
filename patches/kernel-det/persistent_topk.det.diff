+    const int shift = 24 - pass * 8;
+    const uint32_t hi_mask = (pass == 0) ? 0u : (0xFFFFFFFFu << (shift + 8));
+    for (int i = tx; i < 256; i += N_THREADS) hist[i] = 0;
+    __syncthreads();
