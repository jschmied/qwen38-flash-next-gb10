+        const uint32_t k2 = convert_to_uint32_v2(v2), k3 = convert_to_uint32_v2(v3);
+        if (cached) { keys[i] = k0; keys[i + 1] = k1; keys[i + 2] = k2; keys[i + 3] = k3; }
