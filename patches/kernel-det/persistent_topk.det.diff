+// ============================================================================
+// DETERMINISM helpers (jschmied 2026-09-03). The selection kernels below hand
+// out output slots with atomics (thread-arrival order) and take tied candidates
+// at the exact-key round first-come. Both make the result depend on scheduling:
+// the ORDER of the k indices varies run to run, and when more elements share
+// the exact threshold key than fit, the SET varies. The consumer (QSA sparse
+// attention) sums the selected keys in output order, so either forks the
+// hidden state. Fix: (1) tied candidates are ranked by index and the lowest
+// indices win; (2) every finished row is sorted ascending before it leaves the
+// kernel. Both run on data already in shared memory.
+// ============================================================================
+__device__ __forceinline__ uint32_t det_next_pow2(uint32_t n) {
+  uint32_t p = 1;
+  while (p < n) p <<= 1;
+  return p;
+}
+// Sort data[0..n) ascending in shared memory. `cap` must be a power of two
+// >= n and the buffer must be writable up to cap (padding is written).
+template <int N_THREADS>
+__device__ __forceinline__ void det_block_sort_asc(int* data, int n, int cap) {
+  for (int i = threadIdx.x + n; i < cap; i += N_THREADS) data[i] = 0x7FFFFFFF;
+  __syncthreads();
+  for (int k = 2; k <= cap; k <<= 1) {
+    for (int j = k >> 1; j > 0; j >>= 1) {
+      for (int i = threadIdx.x; i < cap; i += N_THREADS) {
+        const int ixj = i ^ j;
+        if (ixj > i) {
+          const int a = data[i], b = data[ixj];
+          const bool up = ((i & k) == 0);
+          if ((a > b) == up) { data[i] = b; data[ixj] = a; }
+        }
+      }
+      __syncthreads();
+    }
+  }
+}
+// Sort a finished output row (global memory, length k) via a shared scratch of
+// >= next_pow2(k) ints.
+template <int N_THREADS>
+__device__ __forceinline__ void det_sort_row(int32_t* row, int k, int* scratch) {
+  const int cap = static_cast<int>(det_next_pow2(static_cast<uint32_t>(k)));
+  for (int i = threadIdx.x; i < k; i += N_THREADS) scratch[i] = row[i];
+  __syncthreads();
+  det_block_sort_asc<N_THREADS>(scratch, k, cap);
+  for (int i = threadIdx.x; i < k; i += N_THREADS) row[i] = scratch[i];
+  __syncthreads();
+}
