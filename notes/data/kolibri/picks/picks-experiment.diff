diff --git a/zig/tests/cuda/kolibri_tests.zig b/zig/tests/cuda/kolibri_tests.zig
index ef73d4e1..6bbee2f3 100644
--- a/zig/tests/cuda/kolibri_tests.zig
+++ b/zig/tests/cuda/kolibri_tests.zig
@@ -311,3 +311,98 @@ pub fn lanesCheck(gpu: Gpu, model: []const u8, set: []const u8, ids_file: []cons
     try check.expect(bad == 0, "kolibri1 lanes: drafted == plain and concurrent == solo", .{});
     check.pass("kolibri1 lanes: drafted == plain (greedy, sampled), two streams == each alone, {d} tokens each", .{count});
 }
+
+/// EXPERIMENT: one prompt pass with the captured Triton norms and one with cuda/norms: which top-k picks flip, where.
+pub fn picks(gpu: Gpu, model: []const u8, set: []const u8, ids_file: []const u8) !void {
+    const gpa = gpu.gpa;
+    const text = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_file, gpa, .limited(1 << 26));
+    defer gpa.free(text);
+    var prompt: std.ArrayList(u32) = .empty;
+    defer prompt.deinit(gpa);
+    var it = std.mem.tokenizeAny(u8, text, ", \n");
+    while (it.next()) |t| try prompt.append(gpa, try std.fmt.parseInt(u32, t, 10));
+    const n = @min(prompt.items.len, 2048);
+    var w = try kolibri1.weights.load(gpa, gpu.io, gpu.d, model, null);
+    defer w.deinit();
+    var k = try kolibri1.kernels.Kernels.load(gpa, gpu.io, gpu.ctx, set);
+    defer k.deinit();
+    var stream = try cuda.Stream.init(gpu.d, false);
+    defer stream.deinit();
+    var m = try kolibri1.forward.Model.init(gpa, gpu.d, stream, &w, 4096, 1, 2048);
+    defer m.deinit();
+    const c = w.config;
+    const slots = c.top_k + 1;
+    const pairs = n * slots;
+    const vocab = c.vocab;
+    var logs: [2]cuda.DeviceBuffer = undefined;
+    var lgs: [2]cuda.DeviceBuffer = undefined;
+    for (0..2) |arm| {
+        logs[arm] = try cuda.DeviceBuffer.alloc(gpu.d, c.layers * pairs * 4);
+        lgs[arm] = try cuda.DeviceBuffer.alloc(gpu.d, vocab * 4);
+        m.pick_log = logs[arm].ptr;
+        const o: kolibri1.kernels.Ops = .{ .k = &k, .s = stream, .triton_norms = arm == 0 or std.c.getenv("TF_EXP_CONTROL") != null };
+        try m.forward(o, &.{.{ .slot = 0, .p0 = 0, .tokens = prompt.items[0..n] }}, true, null, lgs[arm].ptr); // the last row's logits
+    }
+    defer for (&logs, &lgs) |*a, *b| {
+        a.free();
+        b.free();
+    };
+    const pa = try back(gpu, logs[0].ptr, c.layers * pairs * 4);
+    defer gpa.free(pa);
+    const pb = try back(gpu, logs[1].ptr, c.layers * pairs * 4);
+    defer gpa.free(pb);
+    const ia = std.mem.bytesAsSlice(i32, @as([]align(1) u8, pa));
+    const ib = std.mem.bytesAsSlice(i32, @as([]align(1) u8, pb));
+    var first: ?usize = null;
+    var flipped_rows = try gpa.alloc(bool, n);
+    defer gpa.free(flipped_rows);
+    @memset(flipped_rows, false);
+    for (0..c.layers) |l| {
+        var rows_flipped: usize = 0;
+        for (0..n) |r| {
+            const a = ia[(l * n + r) * slots ..][0..slots];
+            const b = ib[(l * n + r) * slots ..][0..slots];
+            var equal = true;
+            for (a) |x| {
+                const found = for (b) |y| {
+                    if (y == x) break true;
+                } else false;
+                if (!found) equal = false;
+            }
+            if (!equal) {
+                rows_flipped += 1;
+                flipped_rows[r] = true;
+                if (first == null) first = l;
+            }
+        }
+        if (rows_flipped > 0) std.debug.print("RESULT layer {d}: {d} of {d} rows pick another expert set\n", .{ l, rows_flipped, n });
+    }
+    const la = try back(gpu, lgs[0].ptr, vocab * 4);
+    defer gpa.free(la);
+    const lb = try back(gpu, lgs[1].ptr, vocab * 4);
+    defer gpa.free(lb);
+    const fa = std.mem.bytesAsSlice(f32, @as([]align(1) u8, la));
+    const fb = std.mem.bytesAsSlice(f32, @as([]align(1) u8, lb));
+    var top1: usize = 0;
+    var flip_max: f32 = 0;
+    var calm_max: f32 = 0;
+    var calm: usize = 0;
+    for (n - 1..n) |r| {
+        const x = fa[0..vocab];
+        const y = fb[0..vocab];
+        var bx: usize = 0;
+        var by: usize = 0;
+        var most: f32 = 0;
+        for (x, y, 0..) |p, q, j| {
+            if (p > x[bx]) bx = j;
+            if (q > y[by]) by = j;
+            most = @max(most, @abs(p - q));
+        }
+        if (bx == by) top1 += 1;
+        if (flipped_rows[r]) flip_max = @max(flip_max, most) else {
+            calm_max = @max(calm_max, most);
+            calm += 1;
+        }
+    }
+    std.debug.print("RESULT {d} rows: first flip at layer {?d}; rows with a flip anywhere {d}; top-1 equal {d}/{d}; largest logit diff: rows without a flip {e} ({d} rows), rows with one {e}\n", .{ n, first, n - calm, top1, n, calm_max, calm, flip_max });
+}
