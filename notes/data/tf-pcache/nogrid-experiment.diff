+/// EXPERIMENT ONLY: TF_EXP_NOGRID resumes and keeps anywhere (the prompt path's bits do not depend on its cuts).
+pub fn off() bool {
+    return std.c.getenv("TF_EXP_NOGRID") != null;
+}
+
 /// A kept state a pass may start from: a grid point inside the prompt.
 pub fn resumable(from: usize, len: usize, step: usize) bool {
-    return from > 0 and from < len and from % step == 0;
+    return from > 0 and from < len and (off() or from % step == 0);
+}
+
+/// The row of the prompt's last token inside the last chunk of a pass from `from`.
+pub fn lastRow(from: usize, len: usize, step: usize) usize {
+    const start = @max(from, (len - 1) - (len - 1) % step);
+    return len - 1 - start;
 }
 
